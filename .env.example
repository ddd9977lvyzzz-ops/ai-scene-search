CATALOG_DB=./db/catalog.sqlite3
SESSION_DB=./db/session.sqlite3
EVENT_DB=./db/events.sqlite3
USER_DB=./db/users.sqlite3

# Full Agent brain. Keep secrets server-side; never put OPENAI_API_KEY in site/*.js.
OPENAI_API_KEY=
OPENAI_AGENT_ENABLED=1
OPENAI_AGENT_REQUIRED=0
OPENAI_AGENT_MODEL=gpt-5.6-terra
OPENAI_BASE_URL=https://api.openai.com

# Optional embedding upgrade. Current reproducible catalog also keeps its local 128d semantic index.
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIM=512

# Real poster enrichment. Required for strict production catalog builds.
TMDB_API_TOKEN=
REQUIRE_REAL_POSTERS=1

# Recommended production state/storage split (not required by the SQLite demo)
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql://user:password@localhost:5432/scene_search

SESSION_BACKEND=sqlite
SESSION_TTL_SECONDS=604800
REDIS_PREFIX=scene_search


# Optional live social-evidence connectors (server-side only; never expose in GitHub Pages JS)
BAIDU_SEARCH_API_KEY=
X_BEARER_TOKEN=
SOCIAL_SEARCH_TIMEOUT=10
